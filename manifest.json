{
  "manifest_version": 3,
  "name": "Azure DevOps Description Diff",
  "author": "dawiisss (K3to)",
  "homepage_url": "https://github.com/dawiisss/",
  "version": "1.0.3",
  "description": "Shows inline diffs for Description and Acceptance Criteria changes in Azure DevOps Work Item History.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Azure DevOps Description Diff",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://dev.azure.com/*",
    "https://*.visualstudio.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "minimum_chrome_version": "109",
  "content_scripts": [
    {
      "matches": [
        "https://dev.azure.com/*",
        "https://*.visualstudio.com/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "content/vendor/purify.js",
        "content/htmldiff.js",
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ]
    }
  ]
}
