{
  "manifest_version": 3,
  "name": "Azure DevOps Description Diff",
  "author": "dawiisss (K3to)",
  "homepage_url": "https://github.com/dawiisss/",
  "version": "1.0.3",
  "description": "Shows inline diffs for Description and Acceptance Criteria changes in Azure DevOps Work Item History.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Azure DevOps Description Diff",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "content/vendor/purify.js",
        "content/htmldiff.js",
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ado-description-diff@dawiisss",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
